# =================================================================
# MAKEFILE FOR LIBFT TESTS
# Use this when your libft functions are in separate .c files
# =================================================================

# Compiler and flags
CC = gcc
CFLAGS = -Wall -Wextra -Werror -I. -I../my-libft

# Path to your libft directory (adjust if needed)
LIBFT_DIR = ../my-libft

# Find all .c files in your libft directory
LIBFT_SRC = $(wildcard $(LIBFT_DIR)/ft_*.c)

# All test main files
TESTS = atoi_main bzero_main calloc_main isalnum_main isalpha_main \
		isascii_main isdigit_main isprint_main memchr_main memcmp_main \
		memcpy_main memmove_main memset_main strchr_main strdup_main \
		strlcat_main strlcpy_main strlen_main strncmp_main strnstr_main \
		strrchr_main tolower_main toupper_main substr_main strjoin_main \
		strtrim_main split_main itoa_main strmapi_main striteri_main \
		put_main

# Executables
EXECS = $(TESTS)

# Default target
all: check_libft $(EXECS)

# Check if libft directory exists and has source files
check_libft:
	@if [ ! -d "$(LIBFT_DIR)" ]; then \
		echo "Error: Libft directory '$(LIBFT_DIR)' not found!"; \
		echo "Please adjust LIBFT_DIR in the Makefile."; \
		exit 1; \
	fi
	@if [ -z "$(LIBFT_SRC)" ]; then \
		echo "Error: No ft_*.c files found in $(LIBFT_DIR)"; \
		echo "Make sure your libft functions are named ft_*.c"; \
		exit 1; \
	fi
	@echo "Found $(words $(LIBFT_SRC)) libft source files"

# Pattern rule to compile each test
%_main: %_main.c
	$(CC) $(CFLAGS) -o $@ $< $(LIBFT_SRC)

# Clean executables
clean:
	rm -f $(EXECS)
	rm -f test_output.txt

# Run all tests
test: all
	@echo "========================================="
	@echo "Running all tests..."
	@echo "========================================="
	@for test in $(EXECS); do \
		echo ""; \
		echo "=================="; \
		echo "Running $$test..."; \
		echo "=================="; \
		./$$test; \
		echo ""; \
	done

# Run a specific test
run_%: %_main
	@echo "Running $<..."
	@./$<

# Debug: show configuration
debug:
	@echo "Configuration:"
	@echo "  LIBFT_DIR = $(LIBFT_DIR)"
	@echo "  CFLAGS = $(CFLAGS)"
	@echo "  Found source files:"
	@for src in $(LIBFT_SRC); do echo "    $$src"; done

.PHONY: all clean test check_libft debug
